{
  "name": "relai-airline-support-agent",
  "version": "0.1.0",
  "description": "Terminal airline customer support agent for RELAI learning loops (TypeScript).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "airline-support": "src/main.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@openai/agents": "^0.13.0",
    "@openai/agents-extensions": "^0.13.0",
    "ai": "^6.0.0",
    "dotenv": "^17.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
